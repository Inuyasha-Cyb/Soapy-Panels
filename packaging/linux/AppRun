#!/usr/bin/env bash
# Soapy Panels: preserve Chromium's sandbox; never silently weaken host policy.
set -euo pipefail
app_dir="$(dirname "$(readlink -f "$0")")"
export APPDIR="$app_dir"
export PATH="$app_dir:$app_dir/usr/sbin${PATH:+:$PATH}"
export XDG_DATA_DIRS="$app_dir/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}:/usr/local/share:/usr/share"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$app_dir/soapy-panels" "$@"
