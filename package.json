{
  "name": "soapy-panels",
  "version": "1.2.0",
  "description": "Speech-bubble maker and editor",
  "main": "app/main/index.js",
  "soapyEdition": "windows-store",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:node": "node tools/checks/check-node.js",
    "start": "electron .",
    "start:community": "node tools/development/start-with-edition.js linux-community",
    "start:plus": "node tools/development/start-with-entitlement.js monthly",
    "start:permanent": "node tools/development/start-with-entitlement.js permanent",
    "startup:measure": "node tools/development/measure-startup.js",
    "ipc:measure": "node tools/development/measure-ipc-latency.js",
    "licenses:build": "node tools/packaging/generate-third-party-notices.js",
    "licenses:check": "node tools/checks/check-asset-licenses.js",
    "legal:build": "python tools/legal/generate-legal-pdfs.py",
    "media:vendor": "node tools/media/vendor-mediabunny.js",
    "store-launcher:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/build-store-launcher.ps1",
    "store-bridge:build": "node tools/packaging/build-store-bridge.js",
    "pack": "npm run pack:windows",
    "dist": "npm run dist:windows",
    "pack:windows": "npm run licenses:build && npm run store-bridge:build && npm run store-launcher:build && electron-builder --config packaging/electron-builder.json --win --dir",
    "dist:windows": "npm run licenses:build && npm run store-bridge:build && npm run store-launcher:build && npm run msix:assets && electron-builder --config packaging/electron-builder.json --win",
    "pack:linux": "npm run check:node && npm run licenses:build && electron-builder --config packaging/electron-builder.linux.json --linux --dir",
    "dist:linux": "npm run check:node && npm run licenses:build && electron-builder --config packaging/electron-builder.linux.json --linux",
    "make:msix": "npm run licenses:build && npm run store-bridge:build && npm run store-launcher:build && npm run msix:assets && electron-builder --config packaging/electron-builder.json --win appx",
    "make:msixupload": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/make-msixupload.ps1",
    "store:clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force out\\make -ErrorAction SilentlyContinue\"",
    "store:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/verify-msix-identity.ps1",
    "store:package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/build-store-upload.ps1",
    "store:preflight": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/packaging/store-preflight.ps1",
    "store:activation-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/test-store-activation-smoke.ps1",
    "store:ingestion-check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/verify-store-ingestion.ps1",
    "store:registration-reset": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/reset-store-registration.ps1",
    "store:registration-check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/reset-store-registration.ps1 -CheckOnly",
    "store:publisher": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/packaging/verify-store-publisher.ps1",
    "store:check-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/packaging/check-store-icons.ps1",
    "msix:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\packaging\\generate-msix-assets.ps1",
    "store:assets": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools\\packaging\\generate-store-listing-assets.ps1",
    "audit:runtime": "npm audit --omit=dev --audit-level=low",
    "audit:build": "npm audit --audit-level=high",
    "audit:security": "npm run audit:runtime && npm run audit:build",
    "test": "node tools/testing/run-tests.js all",
    "test:unit": "node tools/testing/run-tests.js unit",
    "test:integration": "node tools/testing/run-tests.js integration",
    "test:e2e": "node tools/testing/run-tests.js e2e",
    "test:stop": "node tools/testing/stop-tests.js",
    "test:review": "node tools/testing/review-tests.js",
    "test:debug": "node tools/testing/debug-test.js",
    "test:approve": "node tools/testing/approve-baseline.js",
    "check:structure": "node tools/checks/check-structure.js",
    "check:package": "npm run check:package:windows",
    "check:package:windows": "node tools/checks/check-package.js windows",
    "check:package:linux": "node tools/checks/check-package.js linux",
    "check": "npm run check:structure && npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fonts:coverage:build": "node tools/fonts/generate-font-coverage.js",
    "stickers:build": "node tools/stickers/generate-sticker-manifest.js"
  },
  "keywords": [],
  "author": "Soapy Panels",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.1",
    "globals": "^16.3.0",
    "license-checker": "^25.0.1",
    "playwright": "^1.57.0",
    "pixelmatch": "^4.0.2",
    "pngjs": "^6.0.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "esprima": "^4.0.1",
    "fontkit": "^2.0.4",
    "mediabunny": "1.44.2"
  }
}
